{
  "name": "slice-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean:next-types && next dev --webpack",
    "dev:turbo": "npm run clean:next-types && next dev --turbopack",
    "clean:next-types": "node scripts/clean-next-types.mjs",
    "build": "npm run clean:next-types && prisma generate && next build --webpack",
    "build:turbo": "npm run clean:next-types && prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run clean:next-types && next typegen && tsc --noEmit -p tsconfig.build.json",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:phase1": "node scripts/validate-phase-1.mjs",
    "validate:phase2": "node scripts/validate-phase-2.mjs",
    "validate:phase3": "node scripts/validate-phase-3.mjs",
    "validate:phase4": "node scripts/validate-phase-4.mjs",
    "validate:phase12": "node scripts/production/acceptance.mjs",
    "test:phase4": "node scripts/tests/phase-4-pagination.test.mjs",
    "test:phase12": "node scripts/tests/phase-12-security.test.mjs",
    "test:smoke": "node scripts/production/smoke.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:phase3:prepare": "node scripts/apply-phase-3-schema-indexes.mjs",
    "db:phase3:check": "node scripts/check-phase-3-database.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "backup:database": "node scripts/production/backup-postgres.mjs",
    "verify:backup": "node scripts/production/verify-backup.mjs",
    "restore:database": "node scripts/production/restore-postgres.mjs",
    "quality": "npm run validate:phase1 && npm run validate:phase2 && npm run validate:phase3 && npm run validate:phase4 && npm run validate:phase12 && npm run test:phase4 && npm run test:phase12 && npm run validate:env && npm run db:validate && npm run db:generate && npm run typecheck && npm run lint",
    "validate": "npm run quality && npm run build && npm run test:smoke",
    "verify": "npm run typecheck && npm run lint",
    "verify:production": "npm run validate:phase12 -- --mode=production && npm run validate && npm run audit:production"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@vercel/blob": "^2.3.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.2.11",
    "openai": "^6.48.0",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "8.5.22"
  }
}