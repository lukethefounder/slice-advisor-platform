# =============================================================================
# Slice core runtime — never commit real credentials
# =============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SLICE_STRICT_ENV="false"
# SLICE_ENV_VALIDATION_MODE="development"

# PostgreSQL and Prisma 7 adapter controls
DB_POOL_MAX="5"
DB_CONNECTION_TIMEOUT_MS="5000"
DB_IDLE_TIMEOUT_MS="300000"
DB_STATEMENT_TIMEOUT_MS="120000"
DB_TRANSACTION_MAX_WAIT_MS="5000"
DB_TRANSACTION_TIMEOUT_MS="30000"
DB_QUERY_LOGGING="false"
DB_SLOW_QUERY_MS="750"
DB_APPLICATION_NAME="slice-platform"

# =============================================================================
# Authentication, sessions, encryption, and security
# =============================================================================
SESSION_TTL_HOURS="12"
SESSION_MAX_ACTIVE="5"
CLIENT_PORTAL_SESSION_HOURS="12"
SLICE_SECRET_ENCRYPTION_KEY=""
SECURITY_PEPPER=""
HEALTHCHECK_SECRET=""
CRON_SECRET=""

# CSP defaults to enforcement. Temporarily use report-only only during a
# documented rollout or incident.
SECURITY_CSP_REPORT_ONLY="false"
SECURITY_CSP_REPORT_PATH="/api/security/csp-report"

# Distributed rate limiting fails closed in production by default.
SECURITY_RATE_LIMIT_FAIL_OPEN="false"

# =============================================================================
# Logging and production observability
# =============================================================================
LOG_LEVEL="info"
LOG_INCLUDE_STACKS="false"

# Client-safe sampling value from 0 through 1. 0.25 samples 25% of page loads.
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE="0.25"
WEB_VITALS_RETENTION_DAYS="30"
COMPLETED_JOB_RETENTION_DAYS="45"
FAILED_JOB_RETENTION_DAYS="180"
MAINTENANCE_BATCH_SIZE="2000"
# Leave blank to retain market snapshots indefinitely. Configure only after
# confirming forecast and reporting retention requirements.
MARKET_SNAPSHOT_RETENTION_DAYS=""

# =============================================================================
# AI
# =============================================================================
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_FAST_MODEL=""
OPENAI_EMAIL_MODEL=""
OPENAI_EMAIL_RESEARCH_MODEL=""

# =============================================================================
# Market data and intelligence
# =============================================================================
ALPHA_VANTAGE_API_KEY=""
# realtime, delayed, or blank. Use realtime only with the required entitlement.
ALPHA_VANTAGE_ENTITLEMENT=""
ALPHA_VANTAGE_INTRADAY_INTERVAL="5min"
ALPHA_VANTAGE_RECOMMENDED_POLL_MS="30000"
ALPHA_VANTAGE_HISTORY_CACHE_MS="900000"
ALPHA_VANTAGE_TECHNICAL_LIMIT="25"
ALPHA_VANTAGE_PUBLIC_NEWS_LIMIT="200"
NEXT_PUBLIC_SLICE_REALTIME_POLL_MS="30000"
INTELLIGENCE_SWARM_CACHE_MS="90000"

# =============================================================================
# Email and SMS
# =============================================================================
ENABLE_LIVE_EMAIL="false"
RESEND_API_KEY=""
RESEND_FROM=""
ENABLE_LIVE_SMS="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# =============================================================================
# Private document storage
# =============================================================================
BLOB_READ_WRITE_TOKEN=""
DOCUMENT_ACCESS_SIGNING_SECRET=""
DOCUMENT_MAX_UPLOAD_BYTES="26214400"
NEXT_PUBLIC_DOCUMENT_MAX_UPLOAD_BYTES="26214400"
DOCUMENT_TEXT_PREVIEW_BYTES="65536"
DOCUMENT_ACCESS_URL_TTL_SECONDS="300"
# Required only for local client-upload testing through a secure tunnel.
VERCEL_BLOB_CALLBACK_URL=""

# =============================================================================
# Background work
# =============================================================================
BACKGROUND_JOB_DAILY_HOUR_UTC="14"

# =============================================================================
# Optional Neo4j knowledge graph
# =============================================================================
NEO4J_ENABLED="false"
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
NEO4J_RESEARCH_RUN_RETENTION="12"

# =============================================================================
# Backup and restore tooling (local/CI shell only)
# =============================================================================
# DATABASE_RESTORE_URL must identify a dedicated empty restore target.
DATABASE_RESTORE_URL=""
BACKUP_DIRECTORY="./backups"
ALLOW_PRODUCTION_RESTORE="false"

# Deployment metadata is normally supplied by Vercel.
# VERCEL_ENV="development"
# VERCEL_URL=""
# VERCEL_GIT_COMMIT_SHA=""
# VERCEL_DEPLOYMENT_ID=""